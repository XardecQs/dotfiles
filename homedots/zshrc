alias ls='lsd' ll='lsd -lh' la='lsd -a' lla='lsd -la' lt='lsd --tree'
alias catt='bat --style=plain'
alias grep='grep --color=auto' diff='diff --color=auto'
alias cp='cp --reflink=auto -v' mv='mv -v' #rm='rm -v'

# Navigation
alias ..='cd ..' ...='cd ../..' ....='cd ../../..'
alias ordenar='~/Proyectos/GitHub/dotfiles/scripts/ordenar.sh' desordenar='~/Proyectos/GitHub/dotfiles/scripts/desordenar.sh'

# Quick commands
alias tmx='tmux attach -t main || tmux new-session -s main'
alias c='clear' q='exit' :q='exit' h='history' j='jobs -l'
alias vim='nvim' snvim='sudo -E nvim'

# Git shortcuts
alias g='git' ga='git add' gp='git pull' gc='git commit' \
      gs='git status' gl='git log --oneline --graph' gd='git diff'

# NixOS management
alias nix-shell='nix-shell --run zsh'

# Dotfiles management
alias dots='cd ~/Proyectos/GitHub/dotfiles'
alias dotsn='cd ~/Proyectos/GitHub/dotfiles && nvim'
alias dotsc='cd ~/Proyectos/GitHub/dotfiles && code .'

# Conditional tool aliases
(( $+commands[code] )) && alias codepwd='code "$(pwd)"'
(( $+commands[nautilus] )) && alias napwd='nautilus "$(pwd)" 2>/dev/null & disown'
(( $+commands[fastfetch] )) && alias cf='clear && fastfetch' cff='clear && fastfetch --config ~/.config/fastfetch/13-custom.jsonc'
(( $+commands[unimatrix] )) && alias umatrix='unimatrix -s 95 -f'

#──────────────────── Functions ────────────────────#
# Create directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

extract() {
  local file="$1"

  # 1. Validación de entrada
  if [[ -z "$file" ]]; then
    echo "Uso: extract <archivo>"
    return 1
  fi

  if [[ ! -f "$file" ]]; then
    echo "Error: '$file' no es un archivo válido o no existe."
    return 1
  fi

  echo "Extrayendo '$file'..."

  # 2. Lógica de extracción con verbosidad (-v)
  case "$file" in
    *.tar.bz2|*.tbz2) tar xvjf "$file"    ;;
    *.tar.gz|*.tgz)   tar xvzf "$file"    ;;
    *.tar.xz)         tar xvf  "$file"    ;;
    *.tar)            tar xvf  "$file"    ;;
    *.bz2)            bunzip2 -v "$file"  ;;
    *.gz)             gunzip -v "$file"   ;;
    *.rar)            unrar x "$file"     ;; # unrar ya es verboso por defecto
    *.zip)            unzip "$file"       ;;
    *.Z)              uncompress "$file"  ;;
    *.7z)             7z x "$file"        ;;
    *.xz)             xz -dv "$file"      ;;
    *)
      echo "Error: No se reconoce el formato de '$file'."
      return 1
      ;;
  esac

  # 3. Confirmación de éxito
  if [[ $? -eq 0 ]]; then
    echo "Extracción completada con éxito."
  else
    echo "Ocurrió un error durante la extracción."
    return 1
  fi
}

# Quick backup
backup() { cp -r "$1" "$1.bak"; }

# NixOS specific: rebuild and switch with automatic sudo
rebuild() {
  local flake_path="${1:-/etc/nixos}"
  sudo nixos-rebuild switch --flake "$flake_path"
}

whereisreal() {
  local target="$1"
  local binary_path
  
  binary_path="${target:A}"

  if [[ ! -e "$binary_path" ]]; then
    binary_path=$(which "$target" 2>/dev/null)
  fi

  if [[ -z "$binary_path" || ! -e "$binary_path" ]]; then
    echo "Error: '$target' no es un archivo válido ni un comando en el PATH."
    return 1
  fi

  if [[ -L "$binary_path" ]]; then
    echo "Es un enlace simbólico que apunta a:"
    realpath "$binary_path"
  else
    echo "Es un archivo real (no es un enlace):"
    echo "$binary_path"
  fi
}

crun() {
    if [ -z "$1" ]; then
        echo "Uso: crun archivo.cpp [argumentos...]"
        return 1
    fi

    local file="$1"
    local base=$(basename "${file%.*}")
    local exec="/tmp/crun_$base"

    g++ -std=c++20 -O2 -Wall -Wextra "$file" -o "$exec" || return 1

    "$exec" "${@:2}"
    local exit_code=$?

    rm -f "$exec"
    return $exit_code
}

